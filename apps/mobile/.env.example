# PNL Mobile — Environment Variables
# Copy this file to .env and fill in real values. .env is gitignored.
# Mirrors the web app's NEXT_PUBLIC_* convention. Expo inlines EXPO_PUBLIC_* at build time.

# ── Solana network (the one switch that drives everything) ──────────
# Change this line + restart Expo to switch networks. Same model as web.
EXPO_PUBLIC_SOLANA_NETWORK=devnet

# ── Program IDs ─────────────────────────────────────────────────────
EXPO_PUBLIC_PLP_PROGRAM_ID_DEVNET=2CjwEvY3gkErkEmM5wnLpRv9fq3msHjnPDVPQmaWhF3G
EXPO_PUBLIC_PLP_PROGRAM_ID_MAINNET=C5mVE2BwSehWJNkNvhpsoepyKwZkvSLZx29bi4MzVj86

# ── Helius RPC (get keys at https://helius.xyz/) ────────────────────
EXPO_PUBLIC_HELIUS_DEVNET_RPC=https://devnet.helius-rpc.com/?api-key=your_helius_key_here
EXPO_PUBLIC_HELIUS_MAINNET_RPC=https://mainnet.helius-rpc.com/?api-key=your_helius_key_here

# ── Privy auth (get IDs at https://dashboard.privy.io/) ─────────────
EXPO_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
EXPO_PUBLIC_PRIVY_CLIENT_ID=your_privy_client_id_here

# ── Voice server (mediasoup) ────────────────────────────────────────
EXPO_PUBLIC_VOICE_SERVER_URL=https://voice.pnl.market

# ── API base URL ────────────────────────────────────────────────────
# Empty in dev → uses http://localhost:3000 (the unified backend from start-sim.sh).
# Set to https://pnl.market for TestFlight/production builds.
EXPO_PUBLIC_API_BASE_URL=

# ── Web app URL (deep links, share URLs) ────────────────────────────
EXPO_PUBLIC_APP_URL=https://pnl.market

# ── IPFS gateway (Pinata) ───────────────────────────────────────────
EXPO_PUBLIC_PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# ── Optional: physical-device dev override ──────────────────────────
# Simulator dev uses localhost automatically. Only set this if you're
# running the Expo dev client on a physical device on your LAN.
# EXPO_PUBLIC_DEV_HOST=192.168.1.42
