{
  "name": "pnl-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "turbo run dev --filter=@pnl/web",
    "dev:mobile": "turbo run dev --filter=@pnl/mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@pnl/web",
    "build:shared": "turbo run build --filter=@pnl/shared",
    "lint": "turbo run lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "next": "^15.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "@privy-io/react-auth": "3.14.1",
      "axios": "^1.15.2",
      "sanitize-html": "^2.17.4",
      "react": "^18.3.1",
      "react-dom": "^18.3.1"
    }
  }
}
