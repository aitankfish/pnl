# .vercelignore — controls what gets uploaded to Vercel.
# Uses the same syntax as .gitignore. Vercel only needs the files required
# to build @pnl/docs, which is a standalone Next.js app with no workspace
# internal deps. Everything else can be excluded — speeds up uploads and
# avoids errors like unreadable Unix-domain-socket files in Solana test-
# ledgers ('Unknown system error -102').

# Other apps (deployed separately on Render / TestFlight)
apps/web/
apps/mobile/
Predict and Launch/

# Standalone tools and dev workspaces
pnl-agents/
scripts/
presentation/
test-results/

# Mintlify-era docs scaffold (superseded by apps/docs)
# Note: leading slash anchors to repo root — otherwise the pattern catches
# apps/docs/ too and pnpm can't find @pnl/docs in the workspace.
/docs/

# Build / install artifacts at any depth.
# DO NOT add `**/build/` here — it matches apps/docs/content/docs/build/ which
# contains the developer-section MDX content. Use `.next/` for Next.js build
# output (which is what we'd want excluded anyway). The .next/ pattern already
# covers the actual Next.js build dirs in apps/web/ and apps/docs/.
**/node_modules/
**/.next/
**/.turbo/
**/target/
**/.anchor/
**/dist/
**/.expo/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
